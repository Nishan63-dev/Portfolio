{
  "info": {
    "name": "LeadNexa School Finance API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection for LeadNexa school finance module. Use the login request first to establish session cookies."
  },
  "item": [
    {
      "name": "Open Login Page",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/login",
          "host": ["{{base_url}}"],
          "path": ["login"]
        }
      },
      "response": []
    },
    {
      "name": "Login Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "email",
              "value": "admin@leadnexa.test",
              "type": "text"
            },
            {
              "key": "password",
              "value": "password",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": ["{{base_url}}"],
          "path": ["login"]
        }
      },
      "response": []
    },
    {
      "name": "Dashboard Summary",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/dashboard",
          "host": ["{{base_url}}"],
          "path": ["api", "dashboard"]
        }
      },
      "response": []
    },
    {
      "name": "Income List",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/incomes?per_page=20",
          "host": ["{{base_url}}"],
          "path": ["api", "incomes"],
          "query": [
            {
              "key": "per_page",
              "value": "20"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Income",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"student_name\": \"John Doe\",\n  \"fee_type\": \"Tuition\",\n  \"amount\": 1200.50,\n  \"payment_date\": \"2026-05-26\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/incomes",
          "host": ["{{base_url}}"],
          "path": ["api", "incomes"]
        }
      },
      "response": []
    },
    {
      "name": "Expense List",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/expenses?per_page=20",
          "host": ["{{base_url}}"],
          "path": ["api", "expenses"],
          "query": [
            {
              "key": "per_page",
              "value": "20"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Expense",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expense_title\": \"School Supplies\",\n  \"category\": \"Stationery\",\n  \"amount\": 450.75,\n  \"expense_date\": \"2026-05-26\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/expenses",
          "host": ["{{base_url}}"],
          "path": ["api", "expenses"]
        }
      },
      "response": []
    },
    {
      "name": "Payroll List",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/payrolls?per_page=20",
          "host": ["{{base_url}}"],
          "path": ["api", "payrolls"],
          "query": [
            {
              "key": "per_page",
              "value": "20"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Payroll",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employee_name\": \"Jane Smith\",\n  \"salary\": 2500.00,\n  \"bonus\": 200.00,\n  \"deduction\": 50.00,\n  \"payroll_date\": \"2026-05-26\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/payrolls",
          "host": ["{{base_url}}"],
          "path": ["api", "payrolls"]
        }
      },
      "response": []
    },
    {
      "name": "Summary Report",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/reports/summary?start_date=2026-05-01&end_date=2026-05-31",
          "host": ["{{base_url}}"],
          "path": ["api", "reports", "summary"],
          "query": [
            {
              "key": "start_date",
              "value": "2026-05-01"
            },
            {
              "key": "end_date",
              "value": "2026-05-31"
            }
          ]
        }
      },
      "response": []
    }
  ]
}
